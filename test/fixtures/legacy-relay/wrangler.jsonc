// TEST FIXTURE ONLY: never deploy; shares the production worker name so local storage carries over.
// Every request is refused unless the LEGACY_FIXTURE binding is "1", which only
// test/team-upgrade.test.ts passes (never set it here).
// The 0.6.0 relay's storage layout, for test/team-upgrade.test.ts. Same worker name, Durable Object
// classes and migrations as relay-worker/wrangler.jsonc, so a persisted storage directory written by
// this worker is what the real relay finds when it starts on it (an upgrade from 0.6.0).
{
  "name": "claude-share-relay",
  "main": "index.js",
  "compatibility_date": "2026-10-20",
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "USERS", "class_name": "Users" },
      { "name": "TEAMS", "class_name": "Team" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Users"] },
    { "tag": "v3", "new_sqlite_classes": ["Team"] }
  ]
}
