{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "claude-share-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  // Thedhrupad@gmail.com's Account
  "account_id": "7ed5d8cfe91c1eb8e81711afaea457e0",
  "workers_dev": true,
  "observability": { "enabled": true },
  // Clients below MIN_VERSION are refused with an update message; below LATEST they see "update available".
  // Pre-0.5 clients don't report a version and are kept in their own pool.
  "vars": {
    "LATEST_VERSION": "0.6.1",
    "MIN_VERSION": "0.5.0",
    // Where the relay checks GitHub sign-ins (tests point this at a mock).
    "GITHUB_API_BASE": "https://api.github.com"
  },
  // Secret (set with `wrangler secret put`): TOKEN_SIGNING_KEY signs mindmeld session tokens.
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      // One per GitHub login: the devices signed in as it.
      { "name": "USERS", "class_name": "Users" },
      // One per team: roster, devices, wrapped team keys and membership log.
      { "name": "TEAMS", "class_name": "Team" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Users"] },
    { "tag": "v3", "new_sqlite_classes": ["Team"] }
  ]
}
